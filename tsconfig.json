{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* DI (tsyringe) — 생성자 주입에 legacy 파라미터 데코레이터가 필요하다.
       표준 ES 데코레이터에는 파라미터 데코레이터가 없어 experimentalDecorators 가 필수다.
       emitDecoratorMetadata 는 보조 수단일 뿐이라 여기에 기대지 않는다 — Repository 는
       생성자 파라미터마다 @inject(Token) 을 명시해 메타데이터 없이도 resolve 되게 쓴다. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
